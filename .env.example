NEXT_PUBLIC_SITE_URL=http://localhost:5000

# Secure consultation intake storage (server-only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CERTIFICATE_BUCKET=consultation-certificates

# Admin login (server-only)
ADMIN_USERNAME=atomcare
ADMIN_PASSWORD=
# Use a random value of at least 32 characters.
ADMIN_SESSION_SECRET=

# Beneficiary eligibility integration (server-only)
# Local example: http://localhost:2000
# Production example: https://beneficiary.atomcare.co.kr
BENEFICIARY_API_BASE_URL=http://localhost:2000
# Use the same random secret only on the two server environments. Never expose it to browser code.
BENEFICIARY_INTEGRATION_SECRET=

# Optional legacy/secondary intake webhook. Leave empty when unused.
CONSULTATION_WEBHOOK_URL=
